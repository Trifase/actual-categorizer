# Actual Budget Connection Configuration
# Copy this file to '.env' and fill in your details

# The URL of your self-hosted Actual Budget server
ACTUAL_SERVER_URL=http://localhost:5006

# Your server password (used to log in to the web interface)
# Alternatively, you can use ACTUAL_TOKEN if you have an API token
ACTUAL_PASSWORD=your_server_password

# The name or Sync ID of your budget file
# If left empty, the script will show a list of files to choose from
ACTUAL_BUDGET_FILE=your_budget_file_name_or_id

# The encryption password for your budget file (if you enabled end-to-end encryption)
# Leave blank if your budget file is not encrypted
ACTUAL_ENCRYPTION_PASSWORD=

# SSL certificate verification settings
# Set to 'False' if your self-hosted instance uses self-signed SSL certificates
# or enter the path to a custom CA certificate file if needed.
# Leave blank or set to 'True' for standard SSL verification.
ACTUAL_CERT=True
